# ==============================================================================
# Root .gitignore for Event Spacing Monorepo Workspace
# Protects environment variables, dependencies, and build outputs
# ==============================================================================

# 1. Environment Secrets (NEVER COMMIT)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env*.local
**/.env
**/.env.local
**/.env.*.local
!.env.example
!**/.env.example

# 2. Dependencies
node_modules/
**/node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# 3. Build & Compiler Artifacts
.next/
**/.next/
dist/
**/dist/
build/
**/build/
out/
**/out/
.turbo/
**/.turbo/

# 4. Logs and Debugging
*.log
logs/
**/logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# 5. Testing & Coverage
coverage/
**/coverage/
.nyc_output

# 6. TypeScript
*.tsbuildinfo
next-env.d.ts
**/next-env.d.ts

# 7. Operating System & IDE Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# 8. Temporary & Scratch Files
scratch/
**/scratch/
tmp/
**/tmp/
