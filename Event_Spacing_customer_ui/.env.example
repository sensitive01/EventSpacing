# ==============================================================================
# Event Spacing Customer UI - Environment Variables Template
# Copy this file to .env or .env.local for local development
# ==============================================================================

# Backend REST API endpoint (Express.js + MongoDB Atlas)
NEXT_PUBLIC_API_URL=http://localhost:5000/api

# Application Metadata & Base URLs
NEXT_PUBLIC_APP_NAME="Event Spacing"
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Default Platform Settings
NEXT_PUBLIC_DEFAULT_CITY="Bengaluru"
NEXT_PUBLIC_SUPPORT_PHONE="+91 98765 43210"
NEXT_PUBLIC_SUPPORT_EMAIL="info@eventspacing.com"

